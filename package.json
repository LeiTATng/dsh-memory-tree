{
  "name": "dsh-memory-tree",
  "version": "1.1.0",
  "description": "DSH (DeepSeek Harness) 记忆树插件：隔离路由 + 主线/支线记忆树 + Merge + Checkpoint + 三套上下文压缩策略。以零依赖 MCP server 形式运行。",
  "keywords": [
    "deepseek",
    "deepseek-harness",
    "dsh",
    "memory",
    "memory-tree",
    "long-term-memory",
    "context-management",
    "agent-skills",
    "mcp"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/LeiTATng/dsh-memory-tree.git"
  },
  "bugs": {
    "url": "https://github.com/LeiTATng/dsh-memory-tree/issues"
  },
  "homepage": "https://github.com/LeiTATng/dsh-memory-tree#readme",
  "type": "module",
  "packageManager": "pnpm@11.7.0",
  "engines": {
    "node": ">=18.0.0"
  },
  "main": "src/server.js",
  "files": [
    "src",
    "cordis.patch.yml",
    "system-instruction.md",
    "README.md",
    "README.en.md",
    "LICENSE"
  ],
  "scripts": {
    "start": "node src/server.js",
    "test": "node test/smoke.mjs"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "compatibility": {
      "dsh": ">=0.1.0-rc.8 <0.2.0 || 0.2.0-rc.2 || 0.2.1-rc.2 || 0.2.1-rc.3 || 0.2.1-rc.5 || 0.2.2-rc.1 || 0.2.2-rc.2",
      "dshReleases": {
        "0.2.2-rc.2": "compatible"
      },
      "profiles": [
        "web",
        "headless"
      ]
    }
  },
  "dependencies": {},
  "license": "MIT"
}
